<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Re-enable with the first union-based release as the baseline. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>PureQL.CSharp.Model.Serialization</PackageId>
    <RootNamespace>PureQL.CSharp.Model.Serialization</RootNamespace>
    <AssemblyName>PureQL.CSharp.Model.Serialization</AssemblyName>
    <Authors>Dmitry Kurochkin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kudima03/PureQL.CSharp.Model.Serialization</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PureQL.CSharp.Model.Serialization.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PureQL.CSharp.Model" Version="0.1.0-preview.14.0.0" />
  </ItemGroup>
</Project>
